<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Plain HTTP to the dev backends is permitted only for the hosts listed in
        res/xml/network_security_config.xml, which the application tag below
        points at. Anything else keeps the API 28+ default of refusing cleartext.
        Without that allowance the request dies before it leaves the device and
        surfaces as a socket error rather than an HTTP status, which reads like a
        backend bug.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Required by DeviceInfoChannel.isOnline and by ConnectivityMonitor's
        registerNetworkCallback, which throws SecurityException without it. That
        failure is caught and reported as UNAVAILABLE, so the app keeps running
        with connectivity checks permanently answering "unknown".
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name="${applicationName}"
        android:label="Task Queue"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
            `.MainActivity` resolves against the Gradle `namespace`, which must be
            com.monorepo.app to match the Kotlin package that declares it.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!--
                Drawn while the engine starts, so the first frame is this
                background rather than a blank white window.
            -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Embedding v2. Absent or set to 1, the Flutter tool refuses to build
            this project rather than failing at runtime.
        -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
